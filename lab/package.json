{
  "name": "@finchtoys/finch-ui-lab",
  "version": "0.1.1",
  "description": "Gallery mini tool that renders every @finchtoys/ui component inside a real Finch webview panel, with live theme and custom-skin switching.",
  "author": {
    "name": "Finch Team",
    "url": "https://finchwork.app"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finchtoys/finch-ui.git",
    "directory": "lab"
  },
  "keywords": [
    "finch",
    "mini-tool",
    "ui",
    "gallery",
    "preview"
  ],
  "scripts": {
    "build:library": "cd ../library && npm run build",
    "build:panel": "vite build --config vite.config.ts",
    "build:backend": "tsc -p tsconfig.backend.json",
    "typecheck": "tsc -p tsconfig.panel.json && tsc -p tsconfig.backend.json --noEmit",
    "build": "npm run build:library && npm run build:panel && npm run build:backend"
  },
  "devDependencies": {
    "@finchtoys/minitool-api": "^0.3.16"
  },
  "finch": {
    "manifestVersion": 1,
    "id": "finch-ui-lab",
    "name": "Finch UI Lab",
    "description": "Browse every @finchtoys/ui component with all states and variants inside a real Finch webview, and switch theme or custom skin live.",
    "main": "dist/index.js",
    "activationEvents": [
      "onStartup"
    ],
    "permissions": {
      "filesystem": "none",
      "network": false,
      "shell": false,
      "sessions": false
    },
    "contributes": {
      "tools": true,
      "skills": false,
      "appPanel": {
        "icon": "palette",
        "viewType": "finch-ui-lab.spike",
        "instanceMode": "single",
        "showInLauncher": true,
        "source": {
          "type": "local",
          "path": "dist/panel/index.html"
        }
      }
    },
    "autoEnable": false,
    "miniToolType": "local"
  }
}
