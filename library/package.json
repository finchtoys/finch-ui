{
  "name": "@finchtoys/ui",
  "version": "0.1.4",
  "description": "Finch's built-in React component library, extracted so mini-tool authors can build panels that look and behave like Finch itself.",
  "author": {
    "name": "Finch Team",
    "url": "https://finchwork.app"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/style.css",
    "dist/types",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.json && node -e \"require('fs').writeFileSync('dist/index.d.ts','export * from \\\"./types/entry\\\";\\n')\"",
    "verify": "node verify-build.mjs",
    "sync": "node sync-copies.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": "^0.556.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finchtoys/finch-ui.git"
  },
  "keywords": [
    "finch",
    "react",
    "components",
    "ui",
    "mini-tool"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@twemoji/parser": "^17.0.2"
  }
}
