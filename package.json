{
  "name": "finch-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finch's UI component library, extracted for mini-tool authors, plus the UI Lab gallery mini tool.",
  "author": {
    "name": "Finch Team",
    "url": "https://finchwork.app"
  },
  "license": "MIT",
  "workspaces": [
    "library",
    "lab"
  ],
  "scripts": {
    "build": "npm run build --workspace @finchtoys/ui && npm run build --workspace finch-ui-lab",
    "verify": "npm run verify --workspace @finchtoys/ui",
    "typecheck": "npm run typecheck --workspace finch-ui-lab",
    "sync": "npm run sync --workspace @finchtoys/ui"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.0",
    "@finchtoys/minitool-api": "^0.3.16",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.556.0",
    "postcss": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
