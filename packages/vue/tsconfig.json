{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../library/styles/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "entry.ts", "vite.config.ts"]
}
